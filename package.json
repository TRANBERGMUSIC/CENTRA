{
  "name": "centra",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @centra/app",
    "relay": "npm start -w @centra/relay",
    "build": "npm run build -w @centra/design-system && npm run build -w @centra/app",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "desktop": "npm run dev -w @centra/desktop",
    "e2e": "node apps/app/e2e.cjs e2e-shots",
    "relay:cf": "npm run dev -w @centra/relay-cf"
  },
  "devDependencies": {
    "@fontsource/manrope": "^5.2.5",
    "@fontsource/newsreader": "^5.2.5",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "5.6",
    "vitest": "^3.2.7"
  }
}
