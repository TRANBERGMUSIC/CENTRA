{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CENTRA",
  "version": "0.2.0",
  "identifier": "dk.tranberg.centra",
  "build": {
    "beforeDevCommand": "npm run dev -w @centra/app",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w @centra/design-system && npm run build -w @centra/app",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CENTRA",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#0B0C0F",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https: http:; frame-src 'self' about: data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:8787 wss: https://github.com https://objects.githubusercontent.com https://api.anthropic.com http://localhost:11434 http://127.0.0.1:11434; media-src 'self' blob: mediastream:; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "copyright": "© 2026 Willads Tranberg",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/TRANBERGMUSIC/CENTRA/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFNUQ4OTA3MDhFNUEyMjYKUldRbW91VUlCNGxkcnJHRHhxMitIYXBRR0xFVndsVWZ0MDRnVURla05NZ0ZtMm9SMmI1UFJNMzcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
