{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "CENTRA main window (Mac and iPhone)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "mailto:*"
        },
        {
          "url": "tel:*"
        },
        {
          "url": "sms:*"
        },
        {
          "url": "x-apple.systempreferences:*"
        }
      ]
    }
  ]
}
